{
  "id": "./",
  "name": "Story Deck",
  "short_name": "Story Deck",
  "description": "A lofi card table for story notes.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#16261f",
  "theme_color": "#16261f",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New idea",
      "short_name": "New idea",
      "description": "Open a blank idea card with the keyboard up",
      "url": "./?new",
      "icons": [{ "src": "icons/new-idea-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
